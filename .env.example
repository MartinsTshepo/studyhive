# Copy this file to .env for local development (.env is git-ignored).
# For the deployed site, add the same two values as GitHub repository secrets instead.
#
# Find both in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The anon / publishable key is designed to be public (it ships in the browser bundle;
# Row Level Security protects the data). NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
